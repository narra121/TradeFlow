# API Configuration (must include the /v1 stage path)
VITE_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/tradequt-dev/v1

# Cognito user pool the app signs in against (Amplify Auth). Values come from the backend stack outputs
# (UserPoolId, UserPoolClientId, CognitoDomain). The domain is optional: without it the Google button is hidden.
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=your-app-client-id
VITE_COGNITO_DOMAIN=auth-tradequt-dev.tradequt.com
